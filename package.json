{
  "name": "@cargoz/crate",
  "version": "0.1.0",
  "description": "Crate — the Cargoz design system. React components + design tokens.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "files": [
    "dist"
  ],
  "main": "./dist/crate.cjs",
  "module": "./dist/crate.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/crate.js",
      "require": "./dist/crate.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./src/styles/tokens.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "figma:pull": "node scripts/figma-pull.mjs",
    "dev": "storybook dev -p 6006",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build": "npm run tokens && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "format": "prettier --write ."
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@storybook/addon-a11y": "^8.6.0",
    "@storybook/addon-essentials": "^8.6.0",
    "@storybook/blocks": "^8.6.0",
    "@storybook/react": "^8.6.0",
    "@storybook/react-vite": "^8.6.0",
    "@storybook/test": "^8.6.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-storybook": "^0.11.3",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^8.6.0",
    "style-dictionary": "^4.3.0",
    "stylelint": "^16.14.0",
    "stylelint-config-standard": "^37.0.0",
    "stylelint-use-logical": "^2.1.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.0.0",
    "vitest-axe": "^0.1.0"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10"
  }
}

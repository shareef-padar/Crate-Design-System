{
  "font-family": {
    "$type": "fontFamily",
    "heading": {
      "$value": "Manrope, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
    },
    "body": {
      "$value": "Lato, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
    }
  },
  "font-weight": {
    "$type": "fontWeight",
    "light": { "$value": "300" },
    "regular": { "$value": "400" },
    "medium": { "$value": "500" },
    "semibold": { "$value": "600" },
    "bold": { "$value": "700" }
  },
  "font-size": {
    "$type": "dimension",
    "display": { "$value": "clamp(2rem, 1.4rem + 3vw, 3rem)" },
    "h1": { "$value": "clamp(1.75rem, 1.4rem + 1.75vw, 2.25rem)" },
    "h2": { "$value": "1.5rem" },
    "h3": { "$value": "1.25rem" },
    "h4": { "$value": "1.125rem" },
    "h5": { "$value": "1rem" },
    "h6": { "$value": "0.875rem" },
    "body-lg": { "$value": "1.125rem" },
    "body": { "$value": "1rem" },
    "body-sm": { "$value": "0.875rem" },
    "caption": { "$value": "0.75rem" }
  },
  "line-height": {
    "$type": "number",
    "display": { "$value": "1.15" },
    "h1": { "$value": "1.2" },
    "h2": { "$value": "1.25" },
    "h3": { "$value": "1.3" },
    "h4": { "$value": "1.35" },
    "h5": { "$value": "1.4" },
    "h6": { "$value": "1.4" },
    "body-lg": { "$value": "1.6" },
    "body": { "$value": "1.6" },
    "body-sm": { "$value": "1.5" },
    "caption": { "$value": "1.4" }
  },
  "letter-spacing": {
    "$type": "dimension",
    "tight": { "$value": "-0.02em" },
    "normal": { "$value": "0em" },
    "wide": { "$value": "0.02em" }
  }
}
